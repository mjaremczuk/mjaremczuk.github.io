---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import LivePreview from '../components/LivePreview.jsx';
import LanguagePicker from '../components/LanguagePicker.astro';

import { getCurrentLanguage, getTranslations } from '../lib/i18n';
import { getAllProjects, getMobileApps } from '../lib/projects';

// 1. Pobierz dane (zgodnie z zasadami Clean Architecture)
const lang = getCurrentLanguage(Astro.url);
const t = getTranslations(lang);
const allProjects = await getAllProjects(lang);
const mobileApps = await getMobileApps(lang);
---

<Layout title={t.title}>
	<main class="page-container">
		<LanguagePicker currentLang={lang} />
		
		<!-- Hero Section -->
		<section class="hero-section">
			<div class="availability-badge">
				<span class="pulse-dot"></span>
				<span>{t.availability}</span>
			</div>
			
			<h1 class="hero-title">
				{t.heroTitle} <span class="gradient-text">{t.heroTitleGradient}</span>
			</h1>
			
			<p class="hero-subtitle">{t.heroSubtitle}</p>
			
			<div class="social-links" aria-label="Social connections">
				<a href="https://github.com/mjaremczuk" class="social-btn" target="_blank" rel="noopener noreferrer">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
						<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
					</svg>
					GitHub
				</a>
				<a href="https://www.linkedin.com/in/micha%C5%82-jaremczuk-559018a1/" class="social-btn">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
						<rect x="2" y="9" width="4" height="12"/>
						<circle cx="4" cy="4" r="2"/>
					</svg>
					LinkedIn
				</a>
				<a href="mailto:michaljaremczuk@gmail.com" class="social-btn">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
						<polyline points="22,6 12,13 2,6"/>
					</svg>
					Contact
				</a>
			</div>
		</section>

		<!-- Projects Grid Section -->
		<section class="projects-section">
			<div class="section-header">
				<h2 class="section-title">{t.projectsTitle}</h2>
				<p class="section-description">{t.projectsDescription}</p>
			</div>
			
			<div class="projects-grid">
				{allProjects.map((project) => (
					<ProjectCard 
						title={project.title}
						description={project.description}
						tags={project.tags}
						stars={project.stars}
						forks={project.forks}
						metric={project.metric}
						metricValue={project.metricValue}
						href={project.href}
						status={project.status}
						accent={project.accent}
					/>
				))}
			</div>
		</section>

		<!-- Interactive Lab Section -->
		<section class="lab-section" id="lab">
			<div class="section-header">
				<h2 class="section-title">{t.labTitle}</h2>
				<p class="section-description">{t.labDescription}</p>
			</div>
			
			<LivePreview client:visible apps={mobileApps} />
		</section>

		<!-- Footer -->
		<footer class="page-footer">
			<p>&copy; {new Date().getFullYear()} Michał Jaremczuk. {t.footer}</p>
		</footer>
	</main>
</Layout>

<style>
	.page-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 80px 24px;
		display: flex;
		flex-direction: column;
		gap: 90px;
		min-height: 100vh;
	}

	/* Hero Section */
	.hero-section {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		max-width: 780px;
		margin-top: 40px;
	}

	.availability-badge {
		display: flex;
		align-items: center;
		gap: 8px;
		background: rgba(34, 197, 94, 0.08);
		border: 1px solid rgba(34, 197, 94, 0.2);
		color: #4ade80;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		font-weight: 500;
		padding: 6px 14px;
		border-radius: 99px;
		margin-bottom: 24px;
	}

	.pulse-dot {
		width: 8px;
		height: 8px;
		background-color: #22c55e;
		border-radius: 50%;
		display: inline-block;
		animation: pulse 1.8s infinite;
	}

	@keyframes pulse {
		0% {
			transform: scale(0.9);
			box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7);
		}
		70% {
			transform: scale(1);
			box-shadow: 0 0 0 8px rgba(34, 197, 94, 0);
		}
		100% {
			transform: scale(0.9);
			box-shadow: 0 0 0 0 rgba(34, 197, 94, 0);
		}
	}

	.hero-title {
		font-size: clamp(2.5rem, 1rem + 5.5vw, 4.25rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		margin-bottom: 20px;
		line-height: 1.1;
	}

	.gradient-text {
		background: linear-gradient(135deg, var(--color-accent-primary) 0%, var(--color-accent-secondary) 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.hero-subtitle {
		font-size: clamp(1.1rem, 1rem + 0.5vw, 1.35rem);
		color: var(--color-text-muted);
		line-height: 1.6;
		margin-bottom: 32px;
		text-wrap: pretty;
	}

	.social-links {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}

	.social-btn {
		display: flex;
		align-items: center;
		gap: 8px;
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid var(--color-border-subtle);
		color: var(--color-text-primary);
		padding: 10px 18px;
		border-radius: 99px;
		font-size: 0.9rem;
		font-weight: 500;
		text-decoration: none;
		transition: background 0.2s, border-color 0.2s, transform 0.2s;
	}

	.social-btn:hover {
		background: rgba(255, 255, 255, 0.08);
		border-color: var(--color-border-glow);
		transform: translateY(-1px);
	}

	.social-btn:active {
		transform: translateY(0);
	}

	/* Projects Section */
	.projects-section {
		display: flex;
		flex-direction: column;
		gap: 36px;
	}

	.section-header {
		max-width: 720px;
	}

	.section-title {
		font-size: 2rem;
		font-weight: 700;
		margin-bottom: 12px;
		letter-spacing: -0.015em;
	}

	.section-description {
		color: var(--color-text-muted);
		font-size: 1.1rem;
		line-height: 1.65;
		text-wrap: pretty;
	}

	.projects-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
		gap: 24px;
	}

	/* Lab Section */
	.lab-section {
		display: flex;
		flex-direction: column;
		gap: 36px;
	}

	/* Footer */
	.page-footer {
		border-top: 1px solid var(--color-border-subtle);
		padding-top: 32px;
		text-align: center;
		color: var(--color-text-dim);
		font-size: 0.9rem;
	}

	@media (max-width: 768px) {
		.page-container {
			padding: 40px 16px;
			gap: 60px;
		}

		.hero-section {
			margin-top: 20px;
		}
	}
</style>